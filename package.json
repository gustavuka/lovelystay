{
  "name": "lovelystay-test",
  "version": "1.0.0",
  "description": "A CLI application to fetch and store GitHub user information",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "console-table-printer": "^2.12.1",
    "dotenv": "^16.5.0",
    "pg-promise": "^11.5.4",
    "ramda": "^0.29.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/ramda": "^0.29.6",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "node-pg-migrate": "^6.2.2",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
